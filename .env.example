# CodeMaster - Configurazione API Key
# Copia questo file in .env e inserisci le tue chiavi API

# ============================================
# Google Gemini
# ============================================
# Ottieni la chiave da: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tua_chiave_gemini

# ============================================
# Groq
# ============================================
# Ottieni la chiave da: https://console.groq.com/keys
GROQ_API_KEY=tua_chiave_groq

# ============================================
# Cloudflare Workers AI
# ============================================
# Ottieni la chiave da: https://dash.cloudflare.com/profile/api-tokens
CLOUD_API_KEY=tua_chiave_cloudflare
CLOUD_ACCOUNT_ID=tuo_account_id_cloudflare

# ============================================
# Altre variabili opzionali
# ============================================
# Se usi provider specifici che richiedono altre chiavi,
# aggiungile qui seguendo lo stesso formato.
